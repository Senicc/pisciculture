<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/water_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header avec nom et actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_nom_bassin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bassin Principal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_etat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actif"
                    android:textSize="12sp"
                    android:textColor="@color/success"
                    android:background="@drawable/rounded_background_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit"
                    style="@style/Widget.Pisciculture.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete"
                    style="@style/Widget.Pisciculture.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="@color/error" />

            </LinearLayout>

        </LinearLayout>

        <!-- Informations principales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏊"
                    android:textSize="24sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_capacite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500 poissons"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capacité"
                    android:textSize="10sp"
                    android:textColor="@color/gray_medium" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="24sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_localisation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Antananarivo"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Localisation"
                    android:textSize="10sp"
                    android:textColor="@color/gray_medium" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏗️"
                    android:textSize="24sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Béton"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type"
                    android:textSize="10sp"
                    android:textColor="@color/gray_medium" />

            </LinearLayout>

        </LinearLayout>

        <!-- Statut de remplissage amélioré -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_background_light_blue"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Taux de remplissage"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tv_fill_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/water_blue"
                    android:background="@drawable/rounded_background_white"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_fill_rate"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                style="@style/Widget.Pisciculture.ProgressBar"
                android:max="100"
                android:progress="65"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock actuel / Capacité totale"
                android:textSize="10sp"
                android:textColor="@color/gray_medium"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tv_stock_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="325 / 500 poissons"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

        </LinearLayout>

        <!-- Statistiques Qualité Eau -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_background_light_blue"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_temperature_bassin_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25°C"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/water_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Température"
                    android:textSize="9sp"
                    android:textColor="@color/on_surface_muted" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_ph_bassin_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7.2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/fish_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="pH"
                    android:textSize="9sp"
                    android:textColor="@color/on_surface_muted" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_oxygene_bassin_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6.8mg/L"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/harvest_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Oxygène"
                    android:textSize="9sp"
                    android:textColor="@color/on_surface_muted" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>